# DeepSeek API key — used SERVER-SIDE only, by the serverless proxy (api/chat.js).
# It is never exposed to the browser. Note: no VITE_ prefix, so Vite will not
# bundle it into the client.
#
# Deployed: set this in your Vercel project's Environment Variables.
# Local live mode: put it here and run `vercel dev` (plain `vite dev` stays in demo mode).
# No key = Demo Mode with pre-written responses.
#
# Get a free key at https://platform.deepseek.com

DEEPSEEK_API_KEY=your-deepseek-key-here
